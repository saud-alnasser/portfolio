---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'education'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const t = strings[locale];
const text = localized(locale, 'education', entry.id);

// The status is shown as it is. The wording per value lives in i18n.ts, so a
// pending certificate never reads as an awarded one.
const status = t.education.status[data.status];
---

<article class="relative ps-7 pb-10 last:pb-0">
  <span aria-hidden="true" class="absolute -start-[5px] top-2 size-2.5 rounded-full bg-border"></span>
  <p class="text-sm text-muted-foreground tabular-nums">{formatPeriod(locale, data.period)}</p>
  <h3 class="mt-1 text-lg font-semibold tracking-tight">{text('institution', data.institution)}</h3>
  <p class="mt-1">{text('studyType', data.studyType)}{t.listSeparator}{text('area', data.area)}</p>
  <p class="mt-2 text-sm text-muted-foreground" data-status={data.status}>{status}</p>
  {
    data.courses && data.courses.length > 0 && (
      <p class="mt-3 max-w-prose text-sm leading-6 text-muted-foreground">
        <span class="text-foreground">{t.education.courses}: </span>
        {data.courses.map((course, index) => text(`courses[${index}]`, course)).join(t.listSeparator)}
      </p>
    )
  }
</article>
