---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'experience'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const t = strings[locale];
const text = localized(locale, 'experience', entry.id);
---

<article class="py-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h3 class="text-lg font-semibold tracking-tight">{text('position', data.position)}</h3>
    <p class="text-sm text-muted-foreground tabular-nums">{formatPeriod(locale, data.period)}</p>
  </div>
  <p class="mt-1 text-sm text-muted-foreground">
    {text('organisation', data.organisation)}{t.listSeparator}{text('location', data.location)}
    {data.kind === 'training' && <span class="ms-2 rounded-sm border border-border px-1.5 py-0.5 text-xs">{t.experience.training}</span>}
  </p>
  <p class="mt-3 max-w-prose leading-7">{text('summary', data.summary)}</p>
  {
    data.highlights.length > 0 && (
      <ul aria-label={t.experience.highlights} class="mt-3 max-w-prose list-disc space-y-1 ps-5 leading-7">
        {data.highlights.map((highlight, index) => (
          <li>{text(`highlights[${index}]`, highlight)}</li>
        ))}
      </ul>
    )
  }
</article>
