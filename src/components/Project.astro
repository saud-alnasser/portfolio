---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const t = strings[locale];
const text = localized(locale, 'projects', entry.id);

// Only a public project shows its links. A described one is private work,
// shown by name and summary so nothing points at it.
const links = data.visibility === 'public' ? (data.links ?? {}) : {};
---

<article class="py-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h3 class="text-lg font-semibold tracking-tight">{data.name}</h3>
    <p class="text-sm text-muted-foreground tabular-nums">{formatPeriod(locale, data.period)}</p>
  </div>
  <p class="mt-1 text-sm text-muted-foreground">{text('role', data.role)}</p>
  <p class="mt-3 max-w-prose leading-7">{text('summary', data.summary)}</p>
  <ul aria-label={t.project.technologies} class="mt-3 flex flex-wrap gap-x-1 text-sm text-muted-foreground">
    {
      data.technologies.map((technology, index) => (
        <li>
          {technology}
          {index < data.technologies.length - 1 && <span aria-hidden="true">{t.listSeparator.trim()}</span>}
        </li>
      ))
    }
  </ul>
  {
    (links.repository || links.live) && (
      <p class="mt-3 flex flex-wrap gap-x-5 text-sm">
        {links.repository && (
          <a href={links.repository} class="text-primary underline underline-offset-4 hover:decoration-2">
            {t.project.repository}
          </a>
        )}
        {links.live && (
          <a href={links.live} class="text-primary underline underline-offset-4 hover:decoration-2">
            {t.project.live}
          </a>
        )}
      </p>
    )
  }
</article>
