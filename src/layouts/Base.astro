---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { localeInfo, otherLocale, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  // The route without its locale prefix, with the trailing slash: "/",
  // "/work/", "/cv/". The layout builds the canonical address, the language
  // switch, and the alternates from it.
  path: string;
}

const { locale, title, description, path } = Astro.props;
const { dir, ogLocale } = localeInfo(locale);
const other = otherLocale(locale);
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const siteName = text('name', profile.data.name);

const site = Astro.site!;
const href = (l: Locale) => `/${l}${path}`;
const home = `/${locale}/`;
const absolute = (l: Locale) => new URL(href(l), site).href;

const nav = [
  { href: home, label: t.nav.home, current: path === '/' },
  { href: `/${locale}/work/`, label: t.nav.work, current: path === '/work/' },
  { href: `/${locale}/education/`, label: t.nav.education, current: path === '/education/' },
];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(locale)} />
    <link rel="alternate" hreflang={locale} href={absolute(locale)} />
    <link rel="alternate" hreflang={other} href={absolute(other)} />
    <link rel="alternate" hreflang="x-default" href={absolute('en')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={localeInfo(other).ogLocale} />
    <!--
      The only script on the site. It applies a stored theme before first
      paint, so the page never flashes the other palette, and wires the
      control once the document is parsed.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (error) {}
        if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored);

        function current() {
          return (
            root.getAttribute('data-theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          );
        }

        document.addEventListener('DOMContentLoaded', function () {
          var control = document.querySelector('[data-theme-toggle]');
          if (!control) return;
          control.addEventListener('click', function () {
            var next = current() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (error) {}
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased motion-safe:transition-colors motion-safe:duration-300">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-10 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
    >
      {t.skipToContent}
    </a>

    <header class="mx-auto w-full max-w-3xl px-6 pt-8 sm:pt-12">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4">
        <a href={home} class="text-base font-semibold tracking-tight hover:text-primary">
          {siteName}
        </a>
        <nav aria-label={t.nav.label} class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm">
          <ul class="flex gap-x-5">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current ? 'page' : undefined}
                    class:list={[
                      'py-1 hover:text-primary motion-safe:transition-colors',
                      item.current ? 'text-foreground underline underline-offset-4 decoration-border' : 'text-muted-foreground',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="flex gap-x-5 border-s border-border ps-5">
            <li>
              <a
                href={href(other)}
                hreflang={other}
                lang={other}
                dir={localeInfo(other).dir}
                class="py-1 text-muted-foreground hover:text-primary motion-safe:transition-colors"
              >
                {localeInfo(other).name}
              </a>
            </li>
            <li>
              <button
                type="button"
                data-theme-toggle
                class="cursor-pointer py-1 text-muted-foreground hover:text-primary motion-safe:transition-colors"
              >
                <span class="sr-only">{t.theme.switchTo} </span>
                <span class="theme-when-light">{t.theme.dark}</span>
                <span class="theme-when-dark">{t.theme.light}</span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="content" class="mx-auto w-full max-w-3xl px-6 py-16 motion-safe:animate-reveal sm:py-20">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-3xl px-6 pb-12 text-sm text-muted-foreground">
      <div class="flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-border pt-6">
        <a href={`mailto:${profile.data.email}`} class="hover:text-primary motion-safe:transition-colors">
          {profile.data.email}
        </a>
        <span>{siteName}</span>
      </div>
    </footer>
  </body>
</html>
