---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import Icon from '../../components/Icon.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The short resume, the document to send with an application, and the page
// the render step writes to /resume.<locale>.pdf. It is the CV's template
// with fewer sections and fewer entries, from the same component
// (src/components/CvDocument.astro), so this page is the actions row and
// nothing else. It runs to at most two pages at either paper in either
// language, which scripts/render-pdf.mjs counts and refuses to publish past.
// How many it actually takes depends on the machine: the same document is one
// page under the fonts Windows resolves for the system stack and two under
// the Linux runner's, which is why the budget is two rather than one.
//
// The machine-readable document stays the CV's, at /<locale>/resume.json,
// which Astro writes beside this route's resume/index.html. No page links to
// it, so a reader following the word "resume" is never handed the JSON.

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

const pdf = withBase(`/resume.${locale}.pdf`);

// The control's name, which is also its tooltip, so the two agree: the words
// a screen reader announces are the words that appear on hover.
const download = fill(t.cv.downloadPdf, { document: t.resume.title });
---

<Base
  locale={locale}
  title={`${t.resume.title}${t.titleSeparator}${name}`}
  description={fill(t.resume.description, { name })}
  path="/resume/"
  column="document"
>
  <!--
    The one control this page opens with, the CV page's control pointed at
    this document. It is a link rather than a button because with no script it
    has to download the published PDF on its own; `data-document-download` is
    the hook the form attaches to later, and nothing is bound to it here.
  -->
  <nav aria-label={t.cv.documents} class="cv-actions mb-10 flex flex-wrap gap-2">
    <a
      href={pdf}
      download
      data-document-download
      title={download}
      class="inline-flex items-center rounded-md border border-border bg-card p-2 hover:border-primary hover:text-primary motion-safe:transition-colors"
    >
      <Icon name="download" class="size-5" />
      <span class="sr-only">{download}</span>
    </a>
  </nav>

  <CvDocument locale={locale} variant="resume" />
</Base>
