---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import DocumentDownload from '../../components/DocumentDownload.astro';
import DocumentForm from '../../components/DocumentForm.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The short resume, the document to send with an application, and the page
// the render step writes to /resume.<locale>.pdf. It is the CV's template
// with fewer sections and fewer entries, from the same component
// (src/components/CvDocument.astro), so this page is the download control,
// the document, and the form the marked address opens, and nothing else. It runs to
// at most two pages at either paper in either language, which
// scripts/render-pdf.mjs counts and refuses to publish past.
// How many it actually takes depends on the machine: the same document is one
// page under the fonts Windows resolves for the system stack and two under
// the Linux runner's, which is why the budget is two rather than one.
//
// The machine-readable document stays the CV's, at /<locale>/resume.json,
// which Astro writes beside this route's resume/index.html. No page links to
// it, so a reader following the word "resume" is never handed the JSON.


export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

const pdf = withBase(`/resume.${locale}.pdf`);
---

<Base
  locale={locale}
  title={`${t.resume.title}${t.titleSeparator}${name}`}
  description={fill(t.resume.description, { name })}
  path="/resume/"
  column="document"
>
  <DocumentDownload locale={locale} pdf={pdf} document={t.resume.title} />

  <CvDocument locale={locale} variant="resume" />

  <DocumentForm locale={locale} pdf={pdf} document={t.resume.title} slot="dialog" />
</Base>
