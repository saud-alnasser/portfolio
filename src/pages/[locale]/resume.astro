---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The one-page resume, the document to send with an application, and the page
// the render step writes to /resume.<locale>.pdf. It is the CV's template
// with fewer sections and fewer entries, from the same component
// (src/components/CvDocument.astro), so this page is the actions row and
// nothing else. It is one page on A4 and on Letter in both languages, which
// scripts/render-pdf.mjs counts and refuses to publish past.
//
// The machine-readable document stays the CV's, at /<locale>/resume.json,
// which Astro writes beside this route's resume/index.html; the actions rows
// on both pages name each link by what it is, so a reader is never sent to
// the JSON by a link that says resume.

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

const pdf = withBase(`/resume.${locale}.pdf`);
const cv = withBase(`/${locale}/cv/`);

const link = 'text-primary underline underline-offset-4 hover:decoration-2';
---

<Base
  locale={locale}
  title={`${t.resume.title}${t.titleSeparator}${name}`}
  description={fill(t.resume.description, { name })}
  path="/resume/"
  column="document"
>
  <nav aria-label={t.cv.documents} class="cv-actions mb-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a href={pdf} download data-document-link="pdf" class={link}>{t.cv.downloadPdf}</a>
    <a href={cv} data-document-link="cv" class={link}>{t.resume.cvLink}</a>
  </nav>

  <CvDocument locale={locale} variant="resume" />
</Base>
