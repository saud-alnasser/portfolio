---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The CV a person reads, one page per language, and the page the render step
// writes to /cv.<locale>.pdf. It holds everything the site shows; the resume
// beside it holds what an application needs. Both are the same document
// component (src/components/CvDocument.astro), so this page is the actions
// row and nothing else.

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

// What this page offers beside itself: the PDF the render step writes beside
// dist/, the JSON Resume document from the endpoint at resume.json.ts, and
// the other document.
const pdf = withBase(`/cv.${locale}.pdf`);
const json = withBase(`/${locale}/resume.json`);
const resume = withBase(`/${locale}/resume/`);

const link = 'text-primary underline underline-offset-4 hover:decoration-2';
---

<Base
  locale={locale}
  title={`${t.cv.title}${t.titleSeparator}${name}`}
  description={fill(t.cv.description, { name })}
  path="/cv/"
  column="document"
>
  <nav aria-label={t.cv.documents} class="cv-actions mb-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a href={pdf} download data-document-link="pdf" class={link}>{t.cv.downloadPdf}</a>
    <a href={json} data-document-link="json" class={link}>{t.cv.downloadJson}</a>
    <a href={resume} data-document-link="resume" class={link}>{t.cv.resumeLink}</a>
  </nav>

  <CvDocument locale={locale} variant="cv" />
</Base>
