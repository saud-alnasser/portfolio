---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import Icon from '../../components/Icon.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The CV a person reads, one page per language, and the page the render step
// writes to /cv.<locale>.pdf. It holds everything the site shows; the resume
// beside it holds what an application needs. Both are the same document
// component (src/components/CvDocument.astro), so this page is the actions
// row and nothing else.

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

// What this page offers beside itself: the PDF the render step writes beside
// dist/, and nothing else. The JSON Resume document keeps its address at
// resume.json.ts, and the header navigation is how a reader reaches the
// resume, so neither needs a link here.
const pdf = withBase(`/cv.${locale}.pdf`);

// The control's name, which is also its tooltip, so the two agree: the words
// a screen reader announces are the words that appear on hover.
const download = fill(t.cv.downloadPdf, { document: t.cv.title });
---

<Base
  locale={locale}
  title={`${t.cv.title}${t.titleSeparator}${name}`}
  description={fill(t.cv.description, { name })}
  path="/cv/"
  column="document"
>
  <!--
    The one control this page opens with. It is a link rather than a button
    because with no script it has to download the published PDF on its own,
    which is what the effort's no-script requirement rests on. The
    `data-document-download` hook is where the form that collects contact
    details attaches later; nothing is bound to it here.
  -->
  <nav aria-label={t.cv.documents} class="cv-actions mb-10 flex flex-wrap gap-2">
    <a
      href={pdf}
      download
      data-document-download
      title={download}
      class="inline-flex items-center rounded-md border border-border bg-card p-2 hover:border-primary hover:text-primary motion-safe:transition-colors"
    >
      <Icon name="download" class="size-5" />
      <span class="sr-only">{download}</span>
    </a>
  </nav>

  <CvDocument locale={locale} variant="cv" />
</Base>
