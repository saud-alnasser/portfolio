---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import DocumentDownload from '../../components/DocumentDownload.astro';
import DocumentForm from '../../components/DocumentForm.astro';
import { fill, locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { withBase } from '../../lib/paths';

// The CV a person reads, one page per language, and the page the render step
// writes to /cv.<locale>.pdf. It holds everything the site shows; the resume
// beside it holds what an application needs. Both are the same document
// component (src/components/CvDocument.astro), so this page is the download
// control, the document, and the form the marked address opens, and nothing
// else.

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

// What this page offers beside itself: the PDF the render step writes beside
// dist/, and nothing else. The JSON Resume document keeps its address at
// resume.json.ts, and the header navigation is how a reader reaches the
// resume, so neither needs a link here.
const pdf = withBase(`/cv.${locale}.pdf`);
---

<Base
  locale={locale}
  title={`${t.cv.title}${t.titleSeparator}${name}`}
  description={fill(t.cv.description, { name })}
  path="/cv/"
  column="document"
>
  {/*
    Which document this is, for a reader who arrived here rather than at the
    resume. A sibling of the actions row and not a part of it: that row holds
    exactly one control and is asserted to (tests/resume.spec.ts), so the line
    sits above it. It is chrome, so the print rules hide it with the row and
    it reaches neither the published PDF nor a generated document.
  */}
  <p data-document-purpose class="cv-purpose mb-4 text-sm text-muted-foreground">{t.cv.purpose}</p>

  <DocumentDownload locale={locale} pdf={pdf} document={t.cv.title} />

  <CvDocument locale={locale} variant="cv" />

  <DocumentForm locale={locale} pdf={pdf} document={t.cv.title} slot="dialog" />
</Base>
