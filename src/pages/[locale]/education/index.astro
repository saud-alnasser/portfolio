---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Education from '../../../components/Education.astro';
import Certificate from '../../../components/Certificate.astro';
import { fill, locales, strings, type Locale } from '../../../lib/i18n';
import { localized } from '../../../lib/localized';
import { byDateAscending, byStartAscending } from '../../../lib/order';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

// One timeline in order of time: high school, then the online courses, then
// university. Institutions sort by their start and certificates by their
// date, together. A certificate with no date cannot be placed by it, so it
// goes immediately before the most recent institution: that is the
// online-courses phase between school and university, whatever dated
// certificates exist. With no institution at all, undated certificates come
// last. src/content/README.md, "education/", says the same for whoever edits the content.
// The first certificate carries the "Certificates" heading, so the section
// the site names exists on this page as well as on the CV.
type Item =
  | { at: string; kind: 'education'; entry: CollectionEntry<'education'> }
  | { at: string; kind: 'certificate'; entry: CollectionEntry<'certificates'> };

const education = (await getCollection('education')).sort((a, b) => byStartAscending(a.data, b.data));
const certificates = (await getCollection('certificates')).sort((a, b) => byDateAscending(a.data, b.data));

const items: Item[] = [
  ...education.map((entry): Item => ({ at: entry.data.period.start, kind: 'education', entry })),
  ...certificates
    .filter((entry) => entry.data.date)
    .map((entry): Item => ({ at: entry.data.date!, kind: 'certificate', entry })),
].sort((a, b) => byStartAscending({ period: { start: a.at } }, { period: { start: b.at } }));

const undated = certificates.filter((entry) => !entry.data.date).map((entry): Item => ({ at: '', kind: 'certificate', entry }));
let lastInstitution = -1;
items.forEach((item, index) => {
  if (item.kind === 'education') lastInstitution = index;
});
items.splice(lastInstitution >= 0 ? lastInstitution : items.length, 0, ...undated);

const firstCertificate = items.findIndex((item) => item.kind === 'certificate');
---

<Base
  locale={locale}
  title={`${t.pages.education.title}${t.titleSeparator}${name}`}
  description={fill(t.pages.education.description, { name })}
  path="/education/"
>
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t.pages.education.title}</h1>

  <section aria-labelledby="studies" class="mt-12">
    <h2 id="studies" class="text-xl font-semibold tracking-tight">{t.sections.studies}</h2>
    <ol class="mt-8 border-s border-border">
      {
        items.map((item, index) => (
          <li>
            {index === firstCertificate && (
              <h3 id="certificates" class="relative ps-7 pb-4 text-base font-semibold tracking-tight text-muted-foreground">
                {t.sections.certificates}
              </h3>
            )}
            {item.kind === 'education' ? (
              <Education locale={locale} entry={item.entry} />
            ) : (
              <div class="relative ps-7 pb-4 last:pb-0">
                <span aria-hidden="true" class="absolute -start-[5px] top-7 size-2.5 rounded-full bg-border"></span>
                <Certificate locale={locale} entry={item.entry} />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</Base>
