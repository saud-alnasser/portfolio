---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Skills from '../../components/Skills.astro';
import { locales, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { byOrderThenName } from '../../lib/order';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const name = text('name', profile.data.name);
const label = text('label', profile.data.label);
const summary = text('summary', profile.data.summary);
const location = text('location', profile.data.location);

// Skills sit on the home page, beside the summary, because they are the
// fastest read for a visitor deciding whether to open the work page.
const skills = (await getCollection('skills')).sort((a, b) => byOrderThenName(a.data, b.data));

const sections = [
  { href: withBase(`/${locale}/work/`), label: t.nav.work, description: t.home.work },
  { href: withBase(`/${locale}/education/`), label: t.nav.education, description: t.home.education },
];
---

<Base locale={locale} title={name} description={summary} path="/" column="grid">
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{name}</h1>
  <p class="mt-3 text-xl text-muted-foreground">{label}</p>
  <p class="mt-8 max-w-prose text-lg leading-8">{summary}</p>

  <section aria-labelledby="contact" class="mt-16">
    <h2 id="contact" class="text-xl font-semibold tracking-tight">{t.home.contact}</h2>
    <dl class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-[12rem_1fr]">
      <dt class="text-muted-foreground">{t.home.email}</dt>
      <dd>
        <a href={`mailto:${profile.data.email}`} class="text-primary underline underline-offset-4 hover:decoration-2">
          {profile.data.email}
        </a>
      </dd>
      {
        profile.data.profiles.map((p) => (
          <>
            <dt class="text-muted-foreground">{p.network}</dt>
            <dd>
              <a href={p.url} class="text-primary underline underline-offset-4 hover:decoration-2">
                {p.username}
              </a>
            </dd>
          </>
        ))
      }
      <dt class="text-muted-foreground">{t.home.location}</dt>
      <dd>{location}</dd>
    </dl>
  </section>

  {
    skills.length > 0 && (
      <section aria-labelledby="skills" class="mt-16">
        <h2 id="skills" class="mb-5 text-xl font-semibold tracking-tight">
          {t.sections.skills}
        </h2>
        <Skills locale={locale} entries={skills} />
      </section>
    )
  }

  <section aria-labelledby="sections" class="mt-16">
    <h2 id="sections" class="text-xl font-semibold tracking-tight">{t.home.sections}</h2>
    <ul class="mt-5 divide-y divide-border border-y border-border">
      {
        sections.map((section) => (
          <li>
            <a
              href={section.href}
              class="group flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 py-4 hover:text-primary motion-safe:transition-colors"
            >
              <span class="font-semibold">{section.label}</span>
              <span class="text-sm text-muted-foreground">{section.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
