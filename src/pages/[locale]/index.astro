---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionCard from '../../components/SectionCard.astro';
import Skills from '../../components/Skills.astro';
import { fill, locales, plural, strings, type Locale, type Strings } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { profileIcon, type ProfileIcon } from '../../lib/networks';
import { byOrderThenName } from '../../lib/order';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const name = text('name', profile.data.name);
const label = text('label', profile.data.label);
const summary = text('summary', profile.data.summary);
const location = text('location', profile.data.location);

const cv = withBase(`/${locale}/cv/`);

// The contact details as actions rather than a table: the label is what the
// visitor reads and the address is in the link, so the page never repeats the
// footer's email line. A profile takes its network's mark where the icon set
// has one and the external link icon where it does not (src/lib/networks.ts).
const actions: { key: string; href: string; icon: 'mail' | 'file' | ProfileIcon; label: string }[] = [
  { key: 'email', href: `mailto:${profile.data.email}`, icon: 'mail', label: t.home.email },
  ...profile.data.profiles.map((p) => ({
    key: p.network.toLowerCase(),
    href: p.url,
    icon: profileIcon(p.network),
    label: p.network,
  })),
  { key: 'cv', href: cv, icon: 'file', label: t.nav.cv },
];

// Skills sit on the home page, above the sections, because they are the
// fastest read for a visitor deciding whether to open the work page.
const skills = (await getCollection('skills')).sort((a, b) => byOrderThenName(a.data, b.data));

// Every count a section card shows is the length of the collection that
// section renders, read here and never written by hand, so a card cannot
// drift from the content source. The visibility filter is the work page's:
// a hidden project stays in the source and out of every output.
const projects = await getCollection('projects', ({ data }) => data.visibility !== 'hidden');
const experience = await getCollection('experience');
const education = await getCollection('education');
const certificates = await getCollection('certificates');

const count = (n: number, noun: keyof Strings['home']['counts']['nouns']) =>
  fill(t.home.counts.line, { count: String(n), noun: plural(locale, n, t.home.counts.nouns[noun]) });

const sections = [
  {
    section: 'work',
    href: withBase(`/${locale}/work/`),
    name: t.nav.work,
    description: t.home.work,
    counts: [count(projects.length, 'projects'), count(experience.length, 'experience')],
  },
  {
    section: 'education',
    href: withBase(`/${locale}/education/`),
    name: t.nav.education,
    description: t.home.education,
    counts: [count(education.length, 'education'), count(certificates.length, 'certificates')],
  },
  { section: 'cv', href: cv, name: t.nav.cv, description: t.home.cv },
];
---

<Base locale={locale} title={name} description={summary} path="/" column="grid">
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{name}</h1>
  <p data-hero-label class="mt-3 text-xl text-muted-foreground">{label}</p>
  <p class="mt-1 text-sm text-muted-foreground">
    <span class="sr-only">{t.home.location}: </span>{location}
  </p>
  <p data-hero-summary class="mt-8 max-w-prose text-lg leading-8">{summary}</p>

  <section aria-labelledby="contact" class="mt-8">
    <h2 id="contact" class="sr-only">{t.home.contact}</h2>
    <ul data-contact-actions class="flex flex-wrap gap-2">
      {
        actions.map((action) => (
          <li>
            <a
              href={action.href}
              data-contact={action.key}
              class="flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm hover:border-primary hover:text-primary motion-safe:transition-colors"
            >
              <Icon name={action.icon} class="size-4" />
              {action.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    skills.length > 0 && (
      <section aria-labelledby="skills" class="mt-16">
        <h2 id="skills" class="mb-5 text-xl font-semibold tracking-tight">
          {t.sections.skills}
        </h2>
        <Skills locale={locale} entries={skills} />
      </section>
    )
  }

  <section aria-labelledby="sections" class="mt-16">
    <h2 id="sections" class="mb-5 text-xl font-semibold tracking-tight">{t.home.sections}</h2>
    <ul data-section-grid class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.map((section) => (
          <li class="h-full">
            <SectionCard locale={locale} {...section} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
